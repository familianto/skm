# ============================================================
# SKM — Environment Variables
# ============================================================
# Salin berkas ini ke .env.local lalu isi nilainya:
#   cp .env.example .env.local
#
# Berkas ini adalah SUMBER KEBENARAN untuk daftar env var SKM.
# Setiap var di bawah benar-benar dibaca oleh kode (src/ atau scripts/).
# JANGAN tulis rahasia asli di sini — hanya placeholder.
#
# Catatan auth: SKM memakai login PIN (bcryptjs) + sesi JWT (jose) di
# cookie httpOnly `skm_session`. SKM TIDAK memakai NextAuth maupun Google
# OAuth/Gmail SSO — jadi tidak ada GOOGLE_CLIENT_ID/SECRET, NEXTAUTH_*,
# atau PIN_SALT.

# ------------------------------------------------------------
# Google Sheets — Database (WAJIB)
# ------------------------------------------------------------
# ID spreadsheet utama dari URL:
#   https://docs.google.com/spreadsheets/d/[THIS_ID]/edit
# Seluruh tab (10 sheet inti + 9 tab modul Qurban) berada di SATU workbook
# yang sama, yaitu spreadsheet ini. Lihat docs/DATABASE_SCHEMA.md.
GOOGLE_SHEETS_ID=

# ------------------------------------------------------------
# Service Account — Kredensial Google (WAJIB)
# ------------------------------------------------------------
# Dari file JSON credentials Service Account (Google Cloud Console).
# Spreadsheet di atas harus di-share ke email ini dengan akses Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key dari JSON Service Account.
# Wrap dengan double quotes, escape newline sebagai \n.
GOOGLE_PRIVATE_KEY=""

# ------------------------------------------------------------
# Auth / Session (WAJIB)
# ------------------------------------------------------------
# Secret untuk menandatangani JWT sesi (cookie `skm_session`).
# Generate dengan: openssl rand -hex 32
SESSION_SECRET=

# (Opsional) Fallback secret — dipakai HANYA jika SESSION_SECRET kosong.
# Sisa dari era single-PIN; boleh dibiarkan kosong jika SESSION_SECRET diisi.
# Generate dengan: openssl rand -hex 32
AUTH_SECRET=

# ------------------------------------------------------------
# Fonnte — WhatsApp API (OPSIONAL)
# ------------------------------------------------------------
# Token API dari dashboard fonnte.com.
# Jika kosong, pengiriman WA otomatis masuk mode mock (tidak benar-benar kirim).
FONNTE_API_TOKEN=

# (Opsional) Paksa mode mock meski token ada. Set "true" untuk mematikan
# pengiriman WA sungguhan (berguna saat dev/test).
FONNTE_MOCK=

# ------------------------------------------------------------
# Modul Qurban (OPSIONAL)
# ------------------------------------------------------------
# Kill-switch modul Qurban. Set "false" untuk memblokir semua rute Qurban
# (default: aktif jika tidak di-set).
QURBAN_MODULE_ENABLED=

# Set "true" untuk mengizinkan login legacy single-PIN selama masa transisi
# multi-user (default: nonaktif).
QURBAN_LEGACY_LOGIN_ENABLED=

# ------------------------------------------------------------
# Rekening Jembatan — hanya untuk SCRIPT migrasi (OPSIONAL)
# ------------------------------------------------------------
# Dipakai oleh scripts/migrate-mutasi-petty-cash.ts untuk memindahkan saldo
# antar-rekening (Bank -> Kas Tunai). Tidak diperlukan untuk operasi normal.
# Default skrip: REK-20260101-0001 -> REK-20260101-0002.
DARI_REKENING_ID=
KE_REKENING_ID=

# ------------------------------------------------------------
# Misc (OPSIONAL)
# ------------------------------------------------------------
# Nama masjid fallback untuk header export Excel/PDF bila kolom
# `master.nama_masjid` kosong.
NEXT_PUBLIC_MASJID_NAME=
