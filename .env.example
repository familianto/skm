# =============================================================================
# SKM (Sistem Keuangan Masjid) — Environment Variables
# =============================================================================
# Salin file ini ke .env.local dan isi dengan nilai yang sesuai.
# JANGAN pernah commit .env.local ke repository.
#
# cp .env.example .env.local
# =============================================================================

# ── Authentication ─────────────────────────────────────────────────────────
# JWT signing secret (minimal 32 karakter, rekomendasi gunakan output dari
#   `openssl rand -base64 32`).
# SESSION_SECRET digunakan oleh F01 multi-user auth.
# AUTH_SECRET adalah fallback legacy (single-PIN), akan dihapus di versi depan.
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars
# AUTH_SECRET=legacy-fallback-secret-do-not-rely-on-this

# ── Google Cloud / Sheets ──────────────────────────────────────────────────
# ID Spreadsheet utama SKM (dari URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_ID=your-main-spreadsheet-id
# ID Spreadsheet terpisah untuk modul Qurban (opsional; fallback ke GOOGLE_SHEETS_ID)
# GOOGLE_SHEETS_QURBAN_ID=your-qurban-spreadsheet-id

# Google Service Account credentials (untuk akses Sheets API)
# Dapatkan dari Google Cloud Console → IAM & Admin → Service Accounts → Keys
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── WhatsApp Gateway (Fonnte) ──────────────────────────────────────────────
# API token dari https://fonnte.com → Dashboard → API Token
FONNTE_API_TOKEN=
# Set ke 'true' untuk mode mock (tidak mengirim WhatsApp sungguhan)
# FONNTE_MOCK=true

# ── Qurban Module ──────────────────────────────────────────────────────────
# Set ke 'false' untuk menonaktifkan seluruh modul Qurban (rollback lever)
# QURBAN_MODULE_ENABLED=true

# Informasi rekening untuk pembayaran Qurban (ditampilkan di halaman publik)
QURBAN_PAYMENT_BANK_NAME=BSI
QURBAN_PAYMENT_ACCOUNT_NUMBER=
QURBAN_PAYMENT_ACCOUNT_HOLDER=

# Nomor WhatsApp panitia Qurban (tanpa spasi, awali dengan 62)
# QURBAN_PANITIA_HP=

# ── Qurban Legacy Login ────────────────────────────────────────────────────
# Aktifkan login legacy single-PIN secara paralel (untuk transisi F01)
# QURBAN_LEGACY_LOGIN_ENABLED=false

# ── Public Branding ────────────────────────────────────────────────────────
# Nama masjid untuk laporan (fallback jika master data kosong)
# NEXT_PUBLIC_MASJID_NAME=Masjid Al-Ikhlas

# ── Migration Scripts (hanya untuk development) ────────────────────────────
# DARI_REKENING_ID=REK-20260101-0001
# KE_REKENING_ID=REK-20260101-0002