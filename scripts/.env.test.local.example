# F01 Preview Integration Test Configuration
#
# Copy this file to `scripts/.env.test.local` and fill in real values.
# .env.test.local is gitignored — never commit secrets here.
#
# Run:    bash scripts/test-f01-preview.sh

# ─── Vercel preview deployment ──────────────────────────────────────────────

# Preview URL for the qurban/f01-auth-multi-user branch.
# No trailing slash. Get it from Vercel dashboard or:
#   vercel ls --scope <team> | grep qurban-f01
PREVIEW_URL=https://skm-git-qurban-f01-auth-multi-user-<team>.vercel.app

# Vercel Deployment Protection bypass token (Settings → Deployment Protection
# → "Protection Bypass for Automation"). Sent as x-vercel-protection-bypass.
# See https://vercel.com/docs/deployment-protection/methods-to-bypass-deployment-protection
VERCEL_BYPASS_TOKEN=

# ─── Hopy's SUPER_ADMIN credentials ─────────────────────────────────────────

# Telepon yang ter-migrate ke anggota table (ANG-20260515-0003).
# Format: 628xxx (canonical normalized).
HOPY_PHONE=628xxxxxxxxxx

# PIN saat ini (sama dengan master.pin_hash plaintext).
HOPY_PIN=
